{
  "name": "arloui",
  "private": true,
  "version": "0.0.0",
  "description": "Arlo UI — copy-paste React Native components, tokens, and CLI. The Tailwind UI / shadcn for React Native.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "packageManager": "npm@10.9.2",
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "playground": "npm --workspace @arloui/docs run playground",
    "playground:clear": "npm --workspace @arloui/docs run playground:clear",
    "playground:tunnel": "npm --workspace @arloui/docs run playground:tunnel",
    "playground:ios": "npm --workspace @arloui/docs run ios",
    "playground:android": "npm --workspace @arloui/docs run android",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "registry:build": "turbo run emit --filter=@arloui/build-registry",
    "icons:build": "turbo run build --filter=@arloui/icons",
    "skill:sync": "tsx scripts/sync-skill.ts",
    "skill:install:cursor": "node scripts/install-skill.mjs cursor",
    "skill:install:claude": "node scripts/install-skill.mjs claude",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build --filter=@arloui/cli && changeset publish",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/node": "^20.16.10",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}

{
  "name": "arloui",
  "private": true,
  "version": "0.0.0",
  "description": "Arlo UI \u2014 copy-paste React Native components, tokens, and CLI. The Tailwind UI / shadcn for React Native.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.5.1",
      "onFail": "warn"
    }
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "@types/react": "19.1.17"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "npm run dev:www",
    "dev:www": "npm --workspace @arloui/www run dev",
    "dev:playground": "npm --workspace @arloui/docs run dev",
    "dev:packages": "turbo run dev --filter=arloui --filter=@arloui/theme --filter=@arloui/tokens --filter=@arloui/utils --filter=@arloui/build-registry",
    "dev:all": "turbo run dev",
    "playground": "npm --workspace @arloui/docs run playground",
    "playground:clear": "npm --workspace @arloui/docs run playground:clear",
    "playground:tunnel": "npm --workspace @arloui/docs run playground:tunnel",
    "playground:ios": "npm --workspace @arloui/docs run ios",
    "playground:android": "npm --workspace @arloui/docs run android",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "registry:build": "turbo run emit --filter=@arloui/build-registry",
    "registry:emit": "npm run emit --workspace @arloui/build-registry",
    "icons:build": "turbo run build --filter=@arloui/icons",
    "snacks:build": "npm run generate --workspace @arloui/build-snacks",
    "skill:sync": "tsx scripts/sync-skill.ts",
    "design:sync": "tsx scripts/sync-design.ts",
    "skill:install:cursor": "node scripts/install-skill.mjs cursor",
    "skill:install:claude": "node scripts/install-skill.mjs claude",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build --filter=arloui && changeset publish",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.60.3",
    "@rollup/rollup-darwin-x64": "4.60.3",
    "@rollup/rollup-linux-arm64-gnu": "4.60.3",
    "@rollup/rollup-linux-x64-gnu": "4.60.3",
    "@tailwindcss/oxide-darwin-arm64": "4.3.0",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.0",
    "lightningcss-darwin-arm64": "1.32.0",
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.29.7",
    "@changesets/cli": "^2.27.9",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.16.10",
    "@types/react": "19.1.17",
    "@vitest/coverage-v8": "^2.1.9",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-preset-expo": "~54.0.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.3.3",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-test-renderer": "19.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  }
}

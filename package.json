{
  "name": "arloui",
  "private": true,
  "version": "0.0.0",
  "description": "Arlo UI — copy-paste React Native components, tokens, and CLI. The Tailwind UI / shadcn for React Native.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "registry:build": "pnpm --filter @arloui/build-registry run build && pnpm --filter @arloui/build-registry run start",
    "icons:build": "pnpm --filter @arloui/build-icons start",
    "skill:sync": "tsx scripts/sync-skill.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build --filter=@arloui/cli && changeset publish",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/node": "^20.16.10",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}

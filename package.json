{
  "name": "arloui",
  "private": true,
  "version": "0.0.0",
  "description": "Arlo UI — copy-paste React Native components, tokens, and CLI. The Tailwind UI / shadcn for React Native.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "packageManager": "npm@10.9.2",
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "@types/react": "19.1.17"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "playground": "npm --workspace @arloui/docs run playground",
    "playground:clear": "npm --workspace @arloui/docs run playground:clear",
    "playground:tunnel": "npm --workspace @arloui/docs run playground:tunnel",
    "playground:ios": "npm --workspace @arloui/docs run ios",
    "playground:android": "npm --workspace @arloui/docs run android",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "registry:build": "turbo run emit --filter=@arloui/build-registry",
    "icons:build": "turbo run build --filter=@arloui/icons",
    "skill:sync": "tsx scripts/sync-skill.ts",
    "skill:install:cursor": "node scripts/install-skill.mjs cursor",
    "skill:install:claude": "node scripts/install-skill.mjs claude",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build --filter=@arloui/cli && changeset publish",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.60.3",
    "@rollup/rollup-darwin-x64": "4.60.3",
    "@rollup/rollup-linux-arm64-gnu": "4.60.3",
    "@rollup/rollup-linux-x64-gnu": "4.60.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@changesets/cli": "^2.27.9",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.16.10",
    "@types/react": "19.1.17",
    "@vitest/coverage-v8": "^2.1.9",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-preset-expo": "~54.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.3.3",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-test-renderer": "^19.1.0",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  }
}

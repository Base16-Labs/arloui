{
  "name": "@arloui/theme",
  "version": "0.1.0",
  "description": "Arlo UI theme provider — wraps the React tree with a token-aware context, exposes `useTheme`, and handles light/dark switching synced to the system color scheme.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Base16-Labs/arloui.git",
    "directory": "packages/theme"
  },
  "homepage": "https://arloui.com",
  "bugs": "https://github.com/Base16-Labs/arloui/issues",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@arloui/tokens": "file:../tokens"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@arloui/eslint-config": "file:../eslint-config",
    "@arloui/tsconfig": "file:../tsconfig",
    "@testing-library/react-native": "^13.2.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.10",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2"
  }
}

{
  "name": "@arloui/icons",
  "version": "0.1.0",
  "description": "Arlo UI — custom icon set compiled from SVG to react-native-svg components.",
  "license": "MIT",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["src", "assets", "README.md"],
  "scripts": {
    "generate": "pnpm --filter @arloui/build-icons start",
    "build": "pnpm run generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ignore-pattern 'src/generated/**'",
    "clean": "rm -rf .turbo"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.74.0",
    "react-native-svg": ">=15.0.0"
  },
  "devDependencies": {
    "@arloui/eslint-config": "workspace:*",
    "@arloui/tsconfig": "workspace:*",
    "@types/react": "~18.2.79",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-svg": "15.8.0",
    "typescript": "^5.6.2"
  }
}

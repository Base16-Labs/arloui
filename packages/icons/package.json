{
  "name": "@arloui/icons",
  "version": "0.1.0",
  "description": "Arlo UI — custom icon set compiled from SVG to react-native-svg components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Base16-Labs/arloui.git",
    "directory": "packages/icons"
  },
  "homepage": "https://arloui.com",
  "bugs": "https://github.com/Base16-Labs/arloui/issues",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "react-native": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./*": {
      "types": "./dist/esm/generated/*.d.ts",
      "react-native": "./dist/esm/generated/*.js",
      "import": "./dist/esm/generated/*.js",
      "require": "./dist/cjs/generated/*.js",
      "default": "./dist/esm/generated/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "tsx ../../tooling/build-icons/src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/finalize-dist.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ignore-pattern 'src/generated/**'",
    "clean": "rm -rf .turbo dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.74.0",
    "react-native-svg": ">=15.0.0"
  },
  "devDependencies": {
    "@arloui/eslint-config": "file:../eslint-config",
    "@arloui/tsconfig": "file:../tsconfig",
    "@types/react": "~19.2.0",
    "react-native-svg": "15.15.4",
    "typescript": "^5.6.2"
  },
  "module": "./dist/esm/index.js",
  "react-native": "./dist/esm/index.js"
}

{
  "name": "@arloui/utils",
  "version": "0.1.0",
  "description": "Tiny shared helpers used by Arlo UI registry components: pressable feedback hook, platform guards, haptics wrapper, style merging.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.74.0"
  },
  "peerDependenciesMeta": {
    "expo-haptics": { "optional": true }
  },
  "devDependencies": {
    "@arloui/eslint-config": "workspace:*",
    "@arloui/tsconfig": "workspace:*",
    "@types/react": "^18.3.11",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2"
  }
}

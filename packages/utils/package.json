{
  "name": "@arloui/utils",
  "version": "0.1.0",
  "description": "Tiny shared helpers used by Arlo UI registry components: pressable feedback hook, platform guards, haptics wrapper, style merging.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "peerDependencies": {
    "expo-haptics": ">=14.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.74.0"
  },
  "peerDependenciesMeta": {
    "expo-haptics": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arloui/eslint-config": "file:../eslint-config",
    "@arloui/tsconfig": "file:../tsconfig",
    "@testing-library/react-native": "^13.2.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "expo-haptics": "~15.0.8",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2"
  }
}

{
  "name": "@arloui/tokens",
  "version": "0.1.0",
  "description": "Arlo UI design tokens — color, type, spacing, radius, motion, shadows, focus rings, blurs, and glass materials. Single source of truth shared by the registry components, docs, and the arlo-ui design skill.",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./raw": "./src/raw.ts",
    "./paletteMain": "./src/paletteMain.ts",
    "./paletteSecondary": "./src/paletteSecondary.ts",
    "./semantic": "./src/semanticColors.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@arloui/eslint-config": "file:../eslint-config",
    "@arloui/tsconfig": "file:../tsconfig",
    "@testing-library/react-native": "^13.2.0",
    "babel-preset-expo": "~54.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2"
  }
}

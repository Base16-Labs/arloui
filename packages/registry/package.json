{
  "name": "@arloui/registry",
  "version": "0.1.0",
  "private": true,
  "description": "Source-of-truth React Native components for Arlo UI. These files are NOT published to npm — they are compiled into per-component JSON entries by tooling/build-registry and then copy-pasted into consumer apps via the CLI.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "@arloui/theme": "workspace:*",
    "@arloui/tokens": "workspace:*",
    "@arloui/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@arloui/eslint-config": "workspace:*",
    "@arloui/tsconfig": "workspace:*",
    "@types/react": "^18.3.11",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "typescript": "^5.6.2"
  }
}

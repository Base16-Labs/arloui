{
  "name": "@arloui/registry",
  "version": "0.1.0",
  "private": true,
  "description": "Source-of-truth React Native components for Arlo UI. These files are NOT published to npm — they are compiled into per-component JSON entries by tooling/build-registry and then copy-pasted into consumer apps via the CLI.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf .turbo",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@arloui/icons": "file:../icons",
    "@arloui/theme": "file:../theme",
    "@arloui/tokens": "file:../tokens",
    "@arloui/utils": "file:../utils"
  },
  "peerDependencies": {
    "expo-haptics": ">=14.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.74.0",
    "react-native-svg": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "expo-haptics": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arloui/eslint-config": "file:../eslint-config",
    "@arloui/tsconfig": "file:../tsconfig",
    "@babel/generator": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@testing-library/react-native": "^13.2.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.10",
    "expo-haptics": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-native-reanimated": "4.5.1",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.6.2"
  }
}

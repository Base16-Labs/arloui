{
  "name": "arloui",
  "version": "0.1.0",
  "description": "Arlo UI CLI — copy-paste React Native components, tokens, and patterns into your Expo or bare RN app.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.cjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "bin": {
    "arloui": "dist/cli.cjs"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://arloui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Base16-Labs/arloui.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "keywords": [
    "react-native",
    "expo",
    "ui",
    "components",
    "design-system",
    "shadcn",
    "tailwind-ui"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "clean": "rm -rf dist .turbo",
    "start": "node dist/cli.cjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "commander": "^12.1.0",
    "kleur": "^4.1.5",
    "ora": "^8.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@arloui/eslint-config": "file:../eslint-config",
    "@arloui/registry": "file:../registry",
    "@arloui/tsconfig": "file:../tsconfig",
    "@types/node": "^20.16.10",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  }
}

{
  "name": "arloui",
  "version": "0.1.0",
  "description": "Arlo UI CLI — copy-paste React Native components, tokens, and patterns into your Expo or bare RN app.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "arloui": "./dist/cli.cjs"
  },
  "files": ["dist"],
  "homepage": "https://arloui.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/arlo-ui/arloui.git",
    "directory": "packages/cli"
  },
  "keywords": ["react-native", "expo", "ui", "components", "design-system", "shadcn", "tailwind-ui"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo",
    "start": "node dist/cli.cjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "commander": "^12.1.0",
    "kleur": "^4.1.5",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@arloui/eslint-config": "workspace:*",
    "@arloui/registry": "workspace:*",
    "@arloui/tsconfig": "workspace:*",
    "@types/node": "^20.16.10",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2"
  }
}

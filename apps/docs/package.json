{
  "name": "@arloui/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Live documentation site for Arlo UI. Built with Expo Router so the same component code runs on iOS, Android, and the web.",
  "main": "expo-router/entry",
  "scripts": {
    "sync-icons": "node ./scripts/sync-icon-gallery.mjs",
    "dev": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "pnpm run sync-icons && expo start --web",
    "build:web": "pnpm run sync-icons && expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app",
    "clean": "rm -rf .expo dist .turbo"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.0",
    "@expo/metro-runtime": "~3.2.3",
    "@arloui/registry": "workspace:*",
    "@arloui/theme": "workspace:*",
    "@arloui/tokens": "workspace:*",
    "@react-navigation/native": "~6.1.18",
    "expo-clipboard": "~6.0.3",
    "@expo/vector-icons": "^14.0.4",
    "debug": "~4.4.0",
    "expo": "~51.0.39",
    "expo-constants": "~16.0.2",
    "expo-font": "~12.0.10",
    "expo-linking": "~6.3.1",
    "expo-modules-core": "~1.12.26",
    "expo-router": "~3.5.23",
    "expo-splash-screen": "~0.27.7",
    "expo-status-bar": "~1.12.1",
    "invariant": "^2.2.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@arloui/tsconfig": "workspace:*",
    "@babel/core": "^7.25.2",
    "@types/react": "~18.2.79",
    "typescript": "^5.6.2"
  }
}

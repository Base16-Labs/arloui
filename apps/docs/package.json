{
  "name": "@arloui/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Expo playground for testing Arlo UI React Native components on device, simulator, and web.",
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": ["typescript"]
    }
  },
  "scripts": {
    "sync-icons": "node ./scripts/sync-icon-gallery.mjs",
    "dev": "expo start --lan --port 8081",
    "playground": "expo start --lan --port 8081",
    "playground:clear": "expo start --lan --port 8081 --clear",
    "playground:tunnel": "expo start --tunnel --port 8081",
    "ios": "expo start --ios --port 8081",
    "android": "expo start --android --port 8081",
    "web": "node ./scripts/sync-icon-gallery.mjs && expo start --web",
    "build:web": "node ./scripts/sync-icon-gallery.mjs && expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test:charts": "jest --config jest.config.cjs --runInBand",
    "lint": "eslint app",
    "clean": "rm -rf .expo dist .turbo"
  },
  "dependencies": {
    "@arloui/icons": "file:../../packages/icons",
    "@arloui/registry": "file:../../packages/registry",
    "@arloui/theme": "file:../../packages/theme",
    "@arloui/tokens": "file:../../packages/tokens",
    "@babel/runtime": "^7.29.0",
    "@expo-google-fonts/doto": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo/dom-webview": "~57.0.1",
    "@expo/log-box": "~57.0.4",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.3",
    "babel-preset-expo": "~57.0.10",
    "buffer": "^6.0.3",
    "debug": "~4.4.0",
    "expo": "~57.0.20",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "invariant": "^2.2.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-is-edge-to-edge": "^1.3.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "react-refresh": "^0.18.0",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@arloui/tsconfig": "file:../../packages/tsconfig",
    "@babel/core": "^7.25.2",
    "@babel/generator": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2"
  }
}

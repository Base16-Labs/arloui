{
  "name": "@arloui/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Expo playground for testing Arlo UI React Native components on device, simulator, and web.",
  "main": "expo-router/entry",
  "scripts": {
    "sync-icons": "node ./scripts/sync-icon-gallery.mjs",
    "dev": "expo start --lan --port 8081",
    "playground": "expo start --lan --port 8081",
    "playground:clear": "expo start --lan --port 8081 --clear",
    "playground:tunnel": "expo start --tunnel --port 8081",
    "ios": "expo start --ios --port 8081",
    "android": "expo start --android --port 8081",
    "web": "node ./scripts/sync-icon-gallery.mjs && expo start --web",
    "build:web": "node ./scripts/sync-icon-gallery.mjs && expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app",
    "clean": "rm -rf .expo dist .turbo"
  },
  "dependencies": {
    "@arloui/icons": "file:../../packages/icons",
    "@arloui/registry": "file:../../packages/registry",
    "@arloui/theme": "file:../../packages/theme",
    "@arloui/tokens": "file:../../packages/tokens",
    "@babel/runtime": "^7.29.0",
    "@expo-google-fonts/doto": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/core": "^7.17.4",
    "@react-navigation/native": "^7.1.8",
    "babel-preset-expo": "~54.0.10",
    "buffer": "^6.0.3",
    "debug": "~4.4.0",
    "expo": "~54.0.34",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-modules-core": "~3.0.30",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "invariant": "^2.2.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-is-edge-to-edge": "^1.3.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-refresh": "^0.18.0",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@arloui/tsconfig": "file:../../packages/tsconfig",
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}

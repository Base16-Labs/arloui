{
  "extends": "@arloui/tsconfig/react-native.json",
  "compilerOptions": {
    "noEmit": true,
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app/**/*",
    "components/**/*",
    "providers/**/*",
    "lib/**/*",
    "data/**/*",
    "*.ts",
    "*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}

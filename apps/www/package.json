{
  "name": "@arloui/www",
  "version": "0.0.0",
  "private": true,
  "description": "ArloUI documentation site \u2014 arloui.com",
  "scripts": {
    "icons:generate": "node scripts/generate-icon-assets.mjs",
    "docs:md": "npm run chart-props:generate && tsx scripts/generate-docs-md.ts",
    "dev": "npm run icons:generate && npm run docs:md && next dev --port 4321",
    "build": "npm run icons:generate && npm run chart-props:generate && NEXT_IGNORE_INCORRECT_LOCKFILE=1 next build",
    "registry:build": "cd ../.. && npm run registry:emit",
    "build:cloudflare": "npm run icons:generate && opennextjs-cloudflare build",
    "preview:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "deploy": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "clean": "rm -rf .next .turbo",
    "chart-props:generate": "tsx scripts/generate-chart-props.ts",
    "chart-examples:check": "tsx scripts/check-chart-examples.ts"
  },
  "dependencies": {
    "@arloui/tokens": "file:../../packages/tokens",
    "@fontsource-variable/manrope": "^5.2.8",
    "@opennextjs/cloudflare": "^1.20.1",
    "esbuild": "^0.27.7",
    "fuse.js": "^7.1.0",
    "next": "16.3.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sugar-high": "^1.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "~19.2.0",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.111.0"
  }
}

{
  "name": "@arloui/www",
  "version": "0.0.0",
  "private": true,
  "description": "ArloUI documentation site — arloui.com",
  "packageManager": "npm@11.5.1",
  "scripts": {
    "dev": "next dev --port 4321",
    "build": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 next build",
    "registry:build": "npm --prefix ../.. run registry:build",
    "build:cloudflare": "npm run registry:build && opennextjs-cloudflare build",
    "preview:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "deploy": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .turbo"
  },
  "dependencies": {
    "@arloui/tokens": "file:../../packages/tokens",
    "@fontsource-variable/manrope": "^5.2.8",
    "@opennextjs/cloudflare": "^1.20.1",
    "fuse.js": "^7.1.0",
    "next": "16.2.6",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sugar-high": "^1.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.111.0"
  }
}

{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".expo/**", "registry/**"]
    },
    "emit": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    },
    "@arloui/icons#build": {
      "dependsOn": ["^build"],
      "outputs": ["src/generated/**"]
    },
    "@arloui/icons#typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@arloui/icons#lint": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}

# npm workspace configuration for Arlo UI.
# This repo is npm-managed (see "packageManager" in package.json + package-lock.json).

# Keep the workspace dependency tree nested rather than aggressively flattened,
# so React Native–facing workspace builds resolve their own copies predictably.
install-strategy=nested

# Align peer resolution with our pinned react / react-native overrides instead of
# erroring on the wide peer ranges some RN libraries declare.
legacy-peer-deps=true
